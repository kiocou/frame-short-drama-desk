{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FRAME 短剧工作台",
  "version": "2.1.0",
  "identifier": "cn.frame.shortdrama",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../ui-dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "FRAME · 短剧工作台",
        "width": 1280,
        "height": 800,
        "minWidth": 1040,
        "minHeight": 680,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "windowEffects": {
          "effects": ["mica"],
          "state": "active"
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data: http: https:; media-src 'self' asset: blob: http: https:; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../static/assets/app_icon.ico"],
    "resources": ["../config.example.json", "../tauri_bridge.py", "../1.py", "../app.py", "../desktop_downloads.py", "../desktop_state.py", "../liushen", "../插件", "../ffmpeg.exe"]
  }
}
